# Optional settings. Copy this file to ".env" to change them (no secrets or API keys are needed).
# The app works without a .env file.

# Used only by:  python -m backend.main   (uvicorn's --host/--port flags override these)
HOST=127.0.0.1
PORT=8000

# Where the imported dataset is stored (SQLite). Default: data/traffic.db
TRAFFIC_DB_PATH=data/traffic.db

# Upload limits for "Import Spark Results"
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=200
